# Machine specific configuration. .env.example documents every variable.
# `task setup:secrets` writes .env from .env.1password. Only .env.example is
# committed. The pre-commit hook rejects every other .env* file.
.env
.env.*
!.env.example

# Agent and editor workspace files. These stay local and are never committed.
# Keep this list in step with ai_re in .githooks/pre-commit.
# `task setup:skills` writes the Claude Code skills to .claude/skills.
.claude/
CLAUDE.md
AGENTS.md
GEMINI.md
HANDOFF.md
PLAN.md
.mcp.json
.cursor/
.cursorrules
.aider*
.continue/
.windsurf/
.codeium/
.github/copilot-instructions.md
.vscode/
.idea/
.vs/
*.swp

# Tooling. package.json and pnpm-lock.yaml are committed. The markdown tools are
# pinned like every other dependency. Only the installed tree stays out.
node_modules/
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Task runner cache
.task/

# OS
Thumbs.db
.DS_Store
