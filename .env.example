# This file lists the variables the setup needs in .env. The values below are
# placeholders. .gitignore covers .env. Create it in one of two ways.
#
# By hand:
#   Copy this file to .env. Fill in the values.
#
# With 1Password (optional):
#   Copy this file to .env.1password (gitignored). Replace each empty value with
#   an op://<vault>/<item>/<field> reference. Run `task setup:secrets`. The
#   1Password CLI resolves the references and writes .env.
#
# Then run `task setup:mcp`. This registers the Claude Code MCP servers. The
# registration holds no token. Claude Code runs `task mcp:headers` on every
# connection, and that task reads the tokens from .env at that moment. The
# registration goes to the project-local Claude Code config under your user
# profile, not to this repository.
#
# Only this file goes into the repository. The pre-commit hook rejects every
# other .env* file.

# GitHub personal access token for the github MCP server.
GITHUB_PAT=

# API key for the context7 MCP server.
CONTEXT7_API_KEY=
